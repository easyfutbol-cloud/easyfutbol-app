{
  "expo": {
    "name": "EasyFutbol App",
    "slug": "easyfutbol-app",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "automatic",
    "scheme": "easyfutbol",
    "ios": {
      "bundleIdentifier": "com.easyfutbol.easyfutbol",
      "buildNumber": "23",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram"
        ]
      }
    },
    "android": {
      "package": "es.easyfutbol.app",
      "versionCode": 23,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-notifications",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "EasyFutbol usa la cámara para escanear el código QR de otros jugadores y añadirlos como amigos, y para hacer tu foto de perfil.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "EasyFutbol guarda en tu galería las tarjetas de estadísticas que descargas.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "287d443d-1c44-43d1-9d00-5d4008cf038e"
      }
    },
    "owner": "easyfutbol",
    "runtimeVersion": "2.2.0-sdk57",
    "updates": {
      "url": "https://u.expo.dev/287d443d-1c44-43d1-9d00-5d4008cf038e"
    }
  }
}
