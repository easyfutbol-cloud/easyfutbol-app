{
  "name": "easyfutbol-backend",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "test:integration": "RUN_DB_INTEGRATION=1 node --test test/integration",
    "migrate": "node src/scripts/runMigrations.js",
    "migrate:status": "node src/scripts/runMigrations.js --status",
    "migrate:dry-run": "node src/scripts/runMigrations.js --dry-run",
    "migrate:verify": "node src/scripts/runMigrations.js --verify-files"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.19.2",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^9.0.3",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
